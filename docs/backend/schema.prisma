generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Concept {
  id                String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conceptId         String              @unique @db.VarChar(100)
  baseConceptId     String              @db.VarChar(100)
  domain            String              @db.VarChar(50)
  conceptSlug       String              @db.VarChar(100)
  sequence          Int
  keywords          String[]            @default([])
  learningObjective String
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @db.Timestamptz(6)
  Content           Content?
  CourseContentItem CourseContentItem[]
  ModuleConcept     ModuleConcept[]
  UserConcept       UserConcept[]

  @@unique([baseConceptId, sequence])
  @@index([baseConceptId])
  @@index([conceptSlug])
  @@index([domain])
  @@index([keywords], type: Gin)
}

model Content {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conceptId   String      @unique @db.Uuid
  contentType ContentType
  title       String?     @db.VarChar(500)
  ytLink      String?     @db.VarChar(500)
  path        String?     @db.VarChar(1000)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @db.Timestamptz(6)
  Concept     Concept     @relation(fields: [conceptId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conceptId])
  @@index([contentType])
}

model Course {
  id                   String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title                String                 @db.VarChar(500)
  description          String?
  difficulty           DifficultyType?        @default(BEGINNER)
  duration_minutes     Int?
  price                Decimal?               @db.Decimal(10, 2)
  is_published         Boolean?               @default(false)
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?              @default(now()) @db.Timestamptz(6)
  domainId             String                 @db.Uuid
  slug                 String?                @unique @db.VarChar(200)
  instructorId         String?                @db.Uuid
  thumbnail            String?
  Domain               Domain                 @relation(fields: [domainId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_course_domain")
  Instructor           Instructor?            @relation(fields: [instructorId], references: [id], onUpdate: NoAction, map: "fk_course_instructor")
  CourseModule         CourseModule[]
  UserContentProgress  UserContentProgress[]
  UserCourseEnrollment UserCourseEnrollment[]
  UserModuleProgress   UserModuleProgress[]
  CourseOrder          CourseOrder[]

  @@index([created_at], map: "idx_course_created_at")
  @@index([difficulty], map: "idx_course_difficulty")
  @@index([instructorId], map: "idx_course_instructor")
  @@index([is_published], map: "idx_course_published")
  @@index([slug], map: "idx_course_slug")
}

model CourseContentItem {
  id                  String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  concept_id          String                @db.Uuid
  content_kind        CourseContentType
  title               String?               @db.VarChar(300)
  sequence_order      Int?                  @default(0)
  is_required         Boolean?              @default(true)
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @default(now()) @db.Timestamptz(6)
  Concept             Concept               @relation(fields: [concept_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_concept")
  MCQ                 MCQ?
  Note                Note?
  UserContentProgress UserContentProgress[]

  @@index([concept_id], map: "idx_content_concept")
  @@index([content_kind], map: "idx_content_kind")
}

model CourseModule {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  course_id   String    @db.Uuid
  module_id   String    @db.Uuid
  order_index Int
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  Course      Course    @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_course")
  Module      Module    @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_module")

  @@unique([course_id, module_id], map: "unique_course_module")
  @@unique([course_id, order_index], map: "unique_course_module_position")
  @@index([course_id, order_index], map: "idx_course_module_composite")
}

model Domain {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  description String?
  createdAt   DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @db.Timestamptz(6)
  Course      Course[]

  @@index([slug], map: "idx_domain_slug")
}

model Instructor {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String   @unique @db.Uuid
  bio            String?
  specialization String?  @db.VarChar(255)
  rating         Float?   @default(0.0)
  socialLinks    Json?    @default("{}")
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @db.Timestamptz(6)
  Course         Course[]
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MCQ {
  id                String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  content_item_id   String            @unique @db.Uuid
  question          String
  options           Json
  correct_answer    String            @db.VarChar(50)
  explanation       String?
  difficulty        String?           @default("medium") @db.VarChar(20)
  CourseContentItem CourseContentItem @relation(fields: [content_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_content_item")
}

model Module {
  id                  String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title               String                @db.VarChar(300)
  description         String?
  domain              String?               @db.VarChar(100)
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @default(now()) @db.Timestamptz(6)
  CourseModule        CourseModule[]
  ModuleConcept       ModuleConcept[]
  UserContentProgress UserContentProgress[]
  UserModuleProgress  UserModuleProgress[]

  @@index([domain], map: "idx_module_domain")
}

model ModuleConcept {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  module_id   String    @db.Uuid
  concept_id  String    @db.Uuid
  order_index Int
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  Concept     Concept   @relation(fields: [concept_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_concept")
  Module      Module    @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_module")

  @@unique([module_id, concept_id], map: "unique_module_concept")
  @@unique([module_id, order_index], map: "unique_module_concept_position")
  @@index([module_id, order_index], map: "idx_module_concept_composite")
}

model Note {
  id                String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  content_item_id   String            @unique @db.Uuid
  format            String?           @default("markdown") @db.VarChar(20)
  body              String
  version           Int?              @default(1)
  CourseContentItem CourseContentItem @relation(fields: [content_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_content_item")
}

model ReadingAssessmentHistory {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId             String   @db.Uuid
  passageId          String   @db.VarChar(100)
  difficulty         String   @db.VarChar(20)
  category           String   @db.VarChar(100)
  wordCount          Int
  readingTimeSeconds Int
  actualWPM          Float
  weightedWPM        Float
  accuracy           Float
  retention          Float
  speedLearningScore Float
  focusRatio         Float
  integrityScore     Float
  tabSwitches        Int
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  User               User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt])
  @@index([userId, difficulty])
}

// ============================================================
// IELTS SPEAKING PRACTICE (renamed from IeltsReadingPractice)
// Stores speaking topics / model answers used by the Speaking
// Practice feature (StudentReadingAssessmentPage.tsx).
// ============================================================

/// Renamed from IeltsReadingPractice → IeltsSpeakingPractice.
/// Actual DB table: "IeltsSpeakingPractice" (PascalCase, Postgres quoted)
/// @migration: ALTER TABLE "IeltsReadingPractice" RENAME TO "IeltsSpeakingPractice";
model IeltsSpeakingPractice {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title       String   @db.VarChar(500)
  modelAnswer String
  keywords    String[]
  tips        String[]
  band        String   @db.VarChar(10)
  type        String   @default("Essay") @db.VarChar(50)
  words       Int?
  phrases     Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)

  IeltsSpeakingAssessment IeltsSpeakingAssessment[]

  @@index([band])
  @@map("IeltsSpeakingPractice")
}

/// Renamed from IeltsReadingAssessment → IeltsSpeakingAssessment.
/// Stores per-session outcomes for the Speaking Practice feature.
/// Actual DB table: "IeltsSpeakingAssessment" (PascalCase, Postgres quoted)
/// @migration: ALTER TABLE "IeltsReadingAssessment" RENAME TO "IeltsSpeakingAssessment";
model IeltsSpeakingAssessment {
  id             String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String               @db.Uuid
  topicId        String               @db.Uuid
  band           String               @db.VarChar(10)
  fluencyScore   Float
  weightedWpm    Float
  keywordsHit    Int
  totalKeywords  Int
  bandLevel      String?              @db.VarChar(10)
  topicTitle     String?              @db.VarChar(500)
  pass1          Json?
  pass2          Json?
  frequentFillers Json?
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)

  User                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  IeltsSpeakingPractice IeltsSpeakingPractice @relation(fields: [topicId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt])
  @@map("IeltsSpeakingAssessment")
}

// ============================================================
// IELTS READING ASSESSMENT (NEW)
// Stores per-session results from the Reading Practice feature
// (ReadingPractice.tsx). Each row represents one completed
// reading session (passage + MCQ answers + performance metrics).
// ============================================================

/// NEW TABLE for Reading Practice sessions.
/// Source: ReadingPractice.tsx → POST /api/reading-practice/submit
/// Actual DB table: "IeltsReadingAssessment" (PascalCase - freed up after rename above)
model IeltsReadingAssessment {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId             String   @db.Uuid

  // Passage identity (links to IeltsSpeedReadingReport.id)
  reportId           String   @db.VarChar(100)
  passageTitle       String   @db.VarChar(500)
  category           String   @db.VarChar(100)
  wordCount          Int

  // Performance metrics
  readingTimeSeconds Int
  wpm                Float                      // words / readingTimeSeconds * 60
  accuracy           Float                      // % correct answers
  retentionScore     Float
  efficiencyScore    Float
  speedLearningScore Float
  grade              String   @db.VarChar(5)    // A+, A, B, C, D, F
  speedCategory      String?  @db.VarChar(50)

  // Q&A summary
  totalQuestions     Int
  correctAnswers     Int

  // Raw data blobs
  scoredAnswers      Json?                      // Array<ScoredAnswer>
  feedbackTips       String[]  @default([])

  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  User               User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt])
  @@index([userId, category])
  @@index([userId, grade])
  @@map("IeltsReadingAssessment")
}

model User {
  id                       String                     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  supabaseuserid           String                     @unique @db.VarChar(255)
  email                    String                     @unique @db.VarChar(255)
  createdAt                DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                   @default(now()) @db.Timestamptz(6)
  name                     String?                    @db.VarChar(255)
  countryCode              String?                    @db.VarChar(5)
  phoneNo                  String?                    @db.VarChar(20)
  role                     UserRoleType               @default(STUDENT)
  profileImage             String?
  // Legacy course-level instructor relation (kept for course relations)
  Instructor               Instructor?
  ReadingAssessmentHistory ReadingAssessmentHistory[]   // Speed Reading history (legacy)
  IeltsReadingAssessment   IeltsReadingAssessment[]     // NEW: Reading Practice sessions
  IeltsSpeakingAssessment  IeltsSpeakingAssessment[]    // Speaking Practice sessions
  UserConcept              UserConcept[]
  UserContentProgress      UserContentProgress[]
  UserCourseEnrollment     UserCourseEnrollment[]
  UserModuleProgress       UserModuleProgress[]
  UserReadingProfile       UserReadingProfile?
  CourseOrder              CourseOrder[]
  // Institute back-relations
  CreatedInstitutes        Institute[]                @relation("InstituteCreatedBy")
  InstituteOwner           InstituteOwner?
  InstituteAdmin           InstituteAdmin?
  InstituteInstructor      InstituteInstructor?
  InstituteStudent         InstituteStudent?

  @@index([email])
}

model UserConcept {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  conceptId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  Concept   Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, conceptId])
  @@index([conceptId])
  @@index([userId])
}

model UserContentProgress {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String            @db.Uuid
  course_id         String            @db.Uuid
  module_id         String            @db.Uuid
  content_item_id   String            @db.Uuid
  status            String            @default("NOT_STARTED") @db.VarChar(50)
  completed_at      DateTime?         @db.Timestamptz(6)
  last_accessed_at  DateTime          @default(now()) @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @db.Timestamptz(6)
  CourseContentItem CourseContentItem @relation(fields: [content_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_content_progress_content_item")
  Course            Course            @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_content_progress_course")
  Module            Module            @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_content_progress_module")
  User              User              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_content_progress_user")

  @@unique([user_id, content_item_id], map: "unique_user_content_progress")
  @@index([last_accessed_at], map: "idx_content_last_accessed")
  @@index([user_id, course_id, module_id], map: "idx_user_content_lookup")
  @@index([user_id, status], map: "idx_user_content_status")
  @@index([user_id, module_id, last_accessed_at(sort: Desc)], map: "idx_user_module_content")
}

model UserCourseEnrollment {
  id               String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String          @db.Uuid
  course_id        String          @db.Uuid
  enrolled_at      DateTime?       @default(now()) @db.Timestamptz(6)
  last_accessed_at DateTime?       @default(now()) @db.Timestamptz(6)
  completed_at     DateTime?       @db.Timestamptz(6)
  status           ProgressStatus? @default(NOT_STARTED)
  module_index     Int?            @default(0)
  Course           Course          @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_course")
  User             User            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user")

  @@unique([user_id, course_id], map: "unique_user_course_enrollment")
  @@index([user_id, status], map: "idx_user_course_enrollment")
}

model UserModuleProgress {
  id               String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String          @db.Uuid
  module_id        String          @db.Uuid
  course_id        String          @db.Uuid
  status           ProgressStatus? @default(NOT_STARTED)
  completed_at     DateTime?       @db.Timestamptz(6)
  last_accessed_at DateTime?       @default(now()) @db.Timestamptz(6)
  Course           Course          @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_course")
  Module           Module          @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_module")
  User             User            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user")

  @@unique([user_id, module_id, course_id], map: "unique_user_module_progress")
  @@index([user_id, course_id], map: "idx_user_progress_lookup")
}

model UserReadingProfile {
  id                    String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId                String   @unique @db.Uuid
  currentWeightedWPM    Float
  currentRetention      Float
  currentSpeedLearning  Float
  currentFocusRatio     Float
  currentIntegrityScore Float
  highestWeightedWPM    Float
  highestRetention      Float
  highestSpeedLearning  Float
  lastAssessmentAt      DateTime @db.Timestamptz(6)
  totalAssessments      Int      @default(0)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @db.Timestamptz(6)
  User                  User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model YouTubeTranscript {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  videoId      String   @unique @db.VarChar(20)
  title        String?  @db.VarChar(500)
  transcript   Json
  method       String?  @db.VarChar(50)
  language     String   @default("en") @db.VarChar(10)
  duration     Int?
  accessCount  Int      @default(0)
  lastAccessed DateTime @default(now()) @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([accessCount])
  @@index([lastAccessed])
  @@index([videoId])
}

enum ContentType {
  YOUTUBE
  NOTES
  PDF
  TEXT
}

enum CourseContentType {
  NOTES
  MCQ
  FLASHCARD
  VIDEO
  PDF
}

enum DifficultyType {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model CourseOrder {
  id                String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId            String         @db.Uuid
  courseId          String         @db.Uuid
  amount            Decimal        @db.Decimal(10, 2)
  currency          String         @default("INR") @db.VarChar(10)
  status            PurchaseStatus @default(PENDING)
  razorpayOrderId   String         @unique @db.VarChar(100)
  razorpayPaymentId String?        @unique @db.VarChar(100)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @db.Timestamptz(6)

  User   User   @relation(fields: [userId], references: [id])
  Course Course @relation(fields: [courseId], references: [id])

  @@index([userId])
  @@index([status])
}

enum PurchaseStatus {
  PENDING
  SUCCESS
  FAILED
}

enum UserRoleType {
  STUDENT
  INSTRUCTOR
  SUPERADMIN
  INSTITUTE_OWNER
  INSTITUTE_ADMIN
  // NOTE: ADMIN kept in DB enum only for migration compatibility; no longer used in app code
  ADMIN
}

// ============================================================
// MULTI-TENANT INSTITUTE SCHEMA (New - Fresh Start)
// All roles are institute-centric. The Institute is the hub.
// ============================================================

model Institute {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  address   String?
  logoUrl   String?  @map("logo_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  CreatedByUser     User?              @relation("InstituteCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  InstituteOwners   InstituteOwner[]
  InstituteAdmins   InstituteAdmin[]
  Instructors       Instructor2[]
  InstituteStudents InstituteStudent[]

  @@index([isActive])
  @@map("institutes")
}

model InstituteOwner {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  instituteId String   @map("institute_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@map("institute_owners")
}

model InstituteAdmin {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  instituteId String   @map("institute_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@map("institute_admins")
}

// Single go-forward instructors table (will link to courses at institute level later)
model InstituteInstructor {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  instituteId    String   @map("institute_id") @db.Uuid
  bio            String?
  specialization String?  @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@map("institute_instructors")
}

model InstituteStudent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  instituteId    String   @map("institute_id") @db.Uuid
  enrollmentDate DateTime @default(now()) @map("enrollment_date") @db.Date
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([isActive])
  @@map("institute_students")
}
